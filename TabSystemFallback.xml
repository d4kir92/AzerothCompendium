<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Script file="TabSystemFallback.lua"/>
	<Button name="TabSystemButtonArtTemplateFallback" mixin="TabSystemButtonArtMixinFallback" virtual="true">
		<KeyValues>
			<KeyValue key="isTabOnTop" value="false" type="boolean"/>
			<KeyValue key="tooltipAnchor" value="ANCHOR_RIGHT" type="string"/>
			<KeyValue key="tooltipAnchorX" value="-12" type="number"/>
			<KeyValue key="tooltipAnchorY" value="-6" type="number"/>
		</KeyValues>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="LeftActive" parentArray="RotatedTextures">
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="RightActive" parentArray="RotatedTextures">
					<Anchors>
						<Anchor point="TOPRIGHT" x="7"/>
					</Anchors>
				</Texture>
				<Texture parentKey="MiddleActive" horizTile="true" parentArray="RotatedTextures">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.LeftActive" relativePoint="RIGHT"/>
						<Anchor point="RIGHT" relativeKey="$parent.RightActive" relativePoint="LEFT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Left" parentArray="RotatedTextures">
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Right" parentArray="RotatedTextures">
					<Anchors>
						<Anchor point="TOPRIGHT" x="6"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Middle" horizTile="true" parentArray="RotatedTextures">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Left" relativePoint="RIGHT"/>
						<Anchor point="RIGHT" relativeKey="$parent.Right" relativePoint="LEFT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" hidden="true">
					<Size x="36" y="35"/>
					<Anchors>
						<Anchor point="BOTTOM"/>
					</Anchors>
				</Texture>
				<MaskTexture parentKey="IconMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="TOPLEFT" x="0" y="-2"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Icon" relativePoint="BOTTOMRIGHT" x="-2" y="0"/>
					</Anchors>
				</MaskTexture>
			</Layer>
			<Layer level="ARTWORK" textureSubLevel="1">
				<Texture parentKey="SquareBackground" parentArray="SquareTextures" hidden="true">
					<Anchors>
						<Anchor point="BOTTOM" x="0" y="1"/>
					</Anchors>
				</Texture>
				<Texture parentKey="SquareBackgroundActive" parentArray="SquareTextures" hidden="true">
					<Anchors>
						<Anchor point="BOTTOM" x="0" y="1"/>
					</Anchors>
				</Texture>
				<Texture parentKey="SquareBackgroundActiveGlow" parentArray="SquareTextures" hidden="true">
					<Anchors>
						<Anchor point="BOTTOM" x="0" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="LeftHighlight" alphaMode="ADD" alpha="0.4" parentArray="RotatedTextures">
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Left"/>
					</Anchors>
				</Texture>
				<Texture parentKey="MiddleHighlight" horizTile="true" alphaMode="ADD" alpha="0.4" parentArray="RotatedTextures">
					<Anchors>
						<Anchor point="LEFT" relativeKey="$parent.Middle" relativePoint="LEFT"/>
						<Anchor point="RIGHT" relativeKey="$parent.Middle" relativePoint="RIGHT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="RightHighlight" alphaMode="ADD" alpha="0.4" parentArray="RotatedTextures">
					<Anchors>
						<Anchor point="TOPRIGHT" relativeKey="$parent.Right"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<ButtonText parentKey="Text">
			<Size x="0" y="10"/>
			<Anchors>
				<Anchor point="CENTER" x="0" y="2"/>
			</Anchors>
		</ButtonText>
		<NormalFont style="GameFontNormalSmall"/>
		<HighlightFont style="GameFontHighlightSmall"/>
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Button>
	<Frame name="LargeSideTabButtonTemplateFallback" mixin="LargeSideTabButtonMixinFallback" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon"/>
				<MaskTexture parentKey="Mask" vWrapMode="CLAMPTOBLACKADDITIVE" hWrapMode="CLAMPTOBLACKADDITIVE">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</MaskTexture>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="SelectedTexture">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="HIGHLIGHT">
				<Texture parentKey="HighlightTexture">
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnMouseDown method="OnMouseDown"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>
</Ui>
